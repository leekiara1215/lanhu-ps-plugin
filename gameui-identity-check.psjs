const ps = require("photoshop");
const fs = require("uxp").storage.localFileSystem;
const core = require("./gameui-core.js");
const store = require("./gameui-ps.js");
const folder = await fs.getEntryWithUrl("file:/Users/betta/.codex/visualizations/2026/11/12/01a1cd79-c50b-7c33-8865-38c38d4029ff/lanhu-gameui-mvp-20261116");
const report = { checks: {} };
try {
    const doc = ps.app.activeDocument;
    if (doc.name !== "LanhuGameUIFoundation20261116.psd") throw new Error("Only the test PSD may be changed.");
    const original = (await store.readMetadata(doc.id)).metadata;
    const node = doc.layers.find(layer => original.nodes[layer.id] && original.nodes[layer.id].kind === "image");
    const before = original.nodes[node.id].nodeId;
    const oldName = node.name;
    node.name = "-h-AuditRenamedInstance";
    report.checks.renameKeepsIdentity = (await store.readMetadata(doc.id)).metadata.nodes[node.id].nodeId === before;
    node.name = oldName;
    const duplicate = await node.duplicate();
    const current = (await store.readMetadata(doc.id)).metadata;
    report.checks.nativeDuplicateDetectedAsUnbound = !current.nodes[duplicate.id];
    current.nodes[duplicate.id] = Object.assign({}, original.nodes[node.id], { nodeId: core.createId() });
    await store.writeMetadata(doc.id, current);
    const registered = (await store.readMetadata(doc.id)).metadata.nodes[duplicate.id];
    report.checks.registeredCopyHasNewNodeIdentity = registered.nodeId !== before;
    report.checks.registeredCopyKeepsAsset = registered.assetRef === original.nodes[node.id].assetRef;
    await duplicate.delete();
    await store.writeMetadata(doc.id, original);
    await doc.save();
    const second = await doc.duplicate("LanhuGameUIFoundation20261116Second");
    const fork = (await store.readMetadata(second.id)).metadata;
    fork.documentId = core.createId(); fork.artboardId = core.createId(); fork.revision = "foundation-second-A";
    for (const key of Object.keys(fork.nodes)) fork.nodes[key].nodeId = core.createId();
    await store.writeMetadata(second.id, fork);
    const path = await folder.createFile("LanhuGameUIFoundation20261116Second.psd", { overwrite: true });
    await second.saveAs.psd(path, { layers: true }, false);
    report.checks.secondDocumentHasOwnIdentity = fork.documentId !== original.documentId && fork.artboardId !== original.artboardId;
    report.checks.secondDocumentKeepsResourceVersion = JSON.stringify(fork.assets) === JSON.stringify(original.assets);
    report.documents = [doc.name, second.name];
} catch (error) { report.error = String(error); report.stack = error.stack; }
const result = await folder.createFile("identity-result.json", { overwrite: true });
await result.write(JSON.stringify(report, null, 2));
