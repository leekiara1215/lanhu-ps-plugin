{
  "manifestVersion": 5,
  "id": "com.bettagames.gameui.authoring.test",
  "name": "GameUI Authoring · 隔离试用",
  "version": "0.6.0",
  "main": "index.html",
  "host": { "app": "PS", "minVersion": "25.0.0", "data": { "apiVersion": 2 } },
  "requiredPermissions": { "localFileSystem": "request", "ipc": { "enablePluginCommunication": true } },
  "entrypoints": [{
    "type": "panel", "id": "gameuiAuthoring", "label": { "default": "GameUI 美术资源 · 试用" },
    "minimumSize": { "width": 320, "height": 480 }, "preferredDockedSize": { "width": 360, "height": 600 },
    "preferredFloatingSize": { "width": 400, "height": 640 }
  }]
}
